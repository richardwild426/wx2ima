{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wx2ima",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {"crons":["0 19 * * *"]},
  "routes": [{"pattern":"wx.example.com/*","zone_name":"example.com"}],
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":true},
  "d1_databases": [{"binding":"DB","database_name":"wx2ima","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"PDFS","bucket_name":"YOUR_BUCKET_NAME"}],
  "workflows": [{"name":"wx2ima-import","binding":"IMPORTS","class_name":"ImportWorkflow"}],
  "vars": {"APP_ORIGIN":"https://wx.example.com"},
  "observability": {"enabled":true,"head_sampling_rate":0.1}
}
